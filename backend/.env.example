# Production Frontend URL
# In production: set this to your Vercel URL (comma-separated for multiple domains)
# Example: FRONTEND_URL=https://schemease.vercel.app,https://www.schemease.com
# In development: omit this to allow localhost origins
FRONTEND_URL=

# Resend Email Configuration for Contact Form (replaces SMTP)
# Resend works from Render Free tier (SMTP ports are blocked on Render Free)
# Follow these steps to set up:
# 1. Sign up at https://resend.com (free tier: 100 emails/day, 3,000/month)
# 2. Get your API key from https://resend.com/api-keys
# 3. Set RESEND_API_KEY below
# 4. All contact form enquiries will be sent to CONTACT_ADMIN_EMAIL
# 5. Reply-To header will be set to the citizen's email for easy replies

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_ADMIN_EMAIL=rakshan3284@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# IMPORTANT:
# - Never commit the actual .env file with real credentials
# - Restart FastAPI after changing environment variables
# - For production, verify your domain with Resend or use their test domain
