# Production Frontend URL
# In production: set this to your Vercel URL (comma-separated for multiple domains)
# Example: FRONTEND_URL=https://schemease.vercel.app,https://www.schemease.com
# In development: omit this to allow localhost origins
FRONTEND_URL=

# Gmail SMTP Configuration for Contact Form
# Follow these steps to set up:
# 1. Enable 2-Step Verification on your Google account (rakshan3284@gmail.com)
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Use the App Password (NOT your normal Gmail password) as SMTP_PASSWORD
# 4. All contact form enquiries will be sent to rakshan3284@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=rakshan3284@gmail.com
SMTP_PASSWORD=your-google-app-password
CONTACT_ADMIN_EMAIL=rakshan3284@gmail.com
CONTACT_FROM_EMAIL=rakshan3284@gmail.com

# IMPORTANT:
# - Never commit the actual .env file with real credentials
# - The App Password is a 16-character code provided by Google
# - Restart FastAPI after changing environment variables
# - Reply-To header will be set to the citizen's email for easy replies
