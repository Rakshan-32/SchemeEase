# =============================
# SchemEase 2.0 — Backend .env
# =============================
# Copy this file to backend/.env and fill in your values.
# NEVER commit a real .env to version control.

# Gemini AI (Google AI Studio): https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Contact Form — SMTP (e.g. Gmail, SendGrid SMTP, Mailgun SMTP)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Use an App Password if 2FA is enabled on your Gmail account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
CONTACT_TO_EMAIL=your_email@gmail.com
